{
  "cSpell.words": [
    "Bitwig",
    "Bitwig's",
    "bwextension",
    "coursier",
    "Coursier",
    "deadband",
    "munit",
    "pitchbendbridge",
    "scalac",
    "scalafmt",
    "typesafe",
    "Wnonunit",
    "Wsafe",
    "Wunused",
    "Wvalue"
  ],
  "[scala]": {
    "editor.defaultFormatter": "scalameta.metals",
    "editor.formatOnSave": true
  },
  "files.watcherExclude": {
    "**/.bsp": true,
    "**/target/**": true
  },
  "files.exclude": {
    "**/.bloop": true,
    "**/.bsp": true,
    "**/.metals": true
  },
  "metals.inlayHints.inferredTypes.enable": true,
  "metals.testUserInterface": "Test Explorer"
}

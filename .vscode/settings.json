{
  "cSpell.words": [
    "Bitwig",
    "Bitwig's",
    "bwextension",
    "deadband",
    "munit",
    "pitchbendbridge",
    "scalafmt"
  ],
  "[scala]": {
    "editor.defaultFormatter": "scalameta.metals",
    "editor.formatOnSave": true
